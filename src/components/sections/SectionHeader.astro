<section class="w-full border-b border-neutral-200 bg-cream-75">
    <div
        class=`max-w-4xl mx-auto border-x border-neutral-200 p-6 sm:px-8 flex items-center ${justifyClass} gap-3 text-xs font-mono text-neutral-400`
    >
        {side === "right" ?
            <span class="tracking-wider uppercase">{title}</span>
            <span>//</span>
            <span>{number}</span>
        :
            <span>{number}</span>
            <span>//</span>
            <span class="tracking-wider uppercase">{title}</span>
        }
    </div>
</section>