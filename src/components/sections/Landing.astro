---

<div class="bg-cream-50">
    <header class="w-full border-t border-neutral-200">
        <div
            class="max-w-4xl mx-auto border-x border-neutral-200 p-6 sm:px-8 sm:flex sm:items-center sm:justify-between font-mono text-xs sm:text-sm"
        >
            <!-- Left: Brand -->
            <a
                href="/"
                class="flex items-center justify-between sm:gap-3 hover:opacity-80 transition-opacity"
            >
                <img
                    src="/images/favicon.svg"
                    alt="Logo"
                    class="w-7 h-7 object-contain shrink-0"
                />
                <span class="font-medium tracking-tight text-neutral-900"
                    >andrea_toaiari</span
                >
            </a>

            <!-- Right: Availability / Role Badge -->
            <div class="hidden sm:flex items-center gap-2 text-neutral-500 text-xs">
                <span class="w-2 h-2 bg-teal-700 animate-pulse"
                ></span>
                <span>AVAILABLE FOR [FREELANCE] WORK</span>
            </div>
        </div>
    </header>

    <!-- Hero -->
    <section class="w-full border-y border-neutral-200">
        <div
            class="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-2 items-stretch border-x border-neutral-200 divide-y md:divide-y-0 md:divide-x divide-neutral-200"
        >
            <div
                class="flex flex-col justify-between p-6 sm:p-8 min-h-[250px]"
            >
                <div class="my-3 sm:my-auto space-y-3">
